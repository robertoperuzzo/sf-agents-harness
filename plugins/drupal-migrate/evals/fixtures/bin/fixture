#!/bin/sh
# fixture: lifecycle of the drupal-migrate eval fixture databases.
#
# POSIX sh; runs on macOS (BSD userland) and Linux. Needs Docker for everything
# except `generate`, which needs python3.
#
#   fixture generate [NAME ...]   regenerate dump.sql and expected.json from spec.json
#   fixture up NAME               start MariaDB for NAME and import its dump (idempotent)
#   fixture down NAME             remove the container and its data
#   fixture status                container state and host port of every fixture
#   fixture query NAME 'SQL'      run one read-only statement as the `reader` user
#   fixture serve                 foreground host executor for eval workspaces (file queue)
#
# Exit status: 0 ok, 1 usage or environment error, 2 statement refused (write,
# more than one statement, client command or executable comment).
#
# Defaults: image mariadb:10.11, container dm-fixture-NAME, a fixed per-fixture
# host port (drupal10 5310, drupal7 5307, wordpress 5336, unknown 5399) bound to
# 127.0.0.1. Override a port with FIXTURE_PORT_<NAME> (upper-case name, e.g.
# FIXTURE_PORT_DRUPAL10=53306). `serve` keeps its registry and pid file under
# ~/.cache/dm-fixture (override: DM_FIXTURE_STATE_DIR).

set -eu

IMAGE="${FIXTURE_IMAGE:-mariadb:10.11}"
ROOT_PASSWORD="${FIXTURE_ROOT_PASSWORD:-root}"
READER_USER="reader"
READER_PASSWORD="reader"
READY_TIMEOUT="${FIXTURE_READY_TIMEOUT:-90}"
IMPORT_MARKER="/var/lib/mysql/.dm-fixture-imported"
SERVE_POLL="${FIXTURE_SERVE_POLL:-0.2}"

self="$0"
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
FIXTURES_DIR=$(cd "$(dirname "$self")/.." && pwd)

real_home() {
  # The eval scaffold runs with HOME pointed at a temporary directory; the
  # registry must live in the real user's home, so resolve it from the login name.
  eval "printf '%s' ~$(id -un)"
}

state_dir() {
  printf '%s' "${DM_FIXTURE_STATE_DIR:-$(real_home)/.cache/dm-fixture}"
}

serve_pid() {
  # prints the pid of a live `fixture serve`, nothing otherwise
  pidfile="$(state_dir)/serve.pid"
  [ -f "$pidfile" ] || return 1
  pid=$(cat "$pidfile" 2>/dev/null || true)
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && printf '%s' "$pid"
}

usage() {
  # The header comment up to the first blank line, without the leading `# `.
  awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$self"
}

die() {
  printf 'fixture: %s\n' "$*" >&2
  exit 1
}

default_port() {
  case "$1" in
    drupal10) echo 5310 ;;
    drupal7) echo 5307 ;;
    wordpress) echo 5336 ;;
    unknown) echo 5399 ;;
    *) echo 5300 ;;
  esac
}

port_for() {
  var="FIXTURE_PORT_$(printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_')"
  # shellcheck disable=SC2016 # the variable name is built at run time on purpose
  override=$(eval "printf '%s' \"\${$var:-}\"")
  if [ -n "$override" ]; then
    printf '%s' "$override"
  else
    default_port "$1"
  fi
}

container_for() {
  printf 'dm-fixture-%s' "$1"
}

fixture_names() {
  for spec in "$FIXTURES_DIR"/*/spec.json; do
    [ -f "$spec" ] || continue
    basename "$(dirname "$spec")"
  done
}

require_fixture() {
  [ -n "${1:-}" ] || die "fixture name required (one of: $(fixture_names | tr '\n' ' '))"
  [ -f "$FIXTURES_DIR/$1/spec.json" ] || die "unknown fixture '$1' (one of: $(fixture_names | tr '\n' ' '))"
}

database_for() {
  # The schema name is the "database" key of spec.json; fall back to the fixture name.
  db=$(sed -n 's/^[[:space:]]*"database":[[:space:]]*"\([^"]*\)".*/\1/p' "$FIXTURES_DIR/$1/spec.json" | head -n 1)
  printf '%s' "${db:-$1}"
}

require_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker is required but 'docker' is not on PATH. Install Docker and start it."
  docker info >/dev/null 2>&1 || die "Docker is installed but the daemon is not reachable. Start Docker and retry."
}

container_state() {
  # prints: absent | running | stopped
  state=$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null || true)
  case "$state" in
    true) echo running ;;
    false) echo stopped ;;
    *) echo absent ;;
  esac
}

is_imported() {
  docker exec -u mysql "$1" test -f "$IMPORT_MARKER" >/dev/null 2>&1
}

wait_ready() {
  # The MariaDB image runs a temporary socket-only server while it initialises;
  # a TCP connection succeeds only once the final server is up.
  waited=0
  while [ "$waited" -lt "$READY_TIMEOUT" ]; do
    if docker exec -u mysql "$1" mariadb -uroot -p"$ROOT_PASSWORD" -h127.0.0.1 --protocol=TCP -e 'SELECT 1' >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  die "container $1 did not become ready within ${READY_TIMEOUT}s (docker logs $1)"
}

import_dump() {
  name=$1
  container=$2
  dump="$FIXTURES_DIR/$name/dump.sql"
  [ -f "$dump" ] || die "$dump missing; run 'fixture generate $name' first"
  printf 'fixture: importing %s/dump.sql into %s\n' "$name" "$container"
  docker exec -i -u mysql "$container" mariadb -uroot -p"$ROOT_PASSWORD" <"$dump"
  docker exec -u mysql "$container" touch "$IMPORT_MARKER"
}

cmd_generate() {
  command -v python3 >/dev/null 2>&1 || die "python3 is required for generate"
  exec python3 -I "$FIXTURES_DIR/generate.py" "$@"
}

cmd_up() {
  require_fixture "${1:-}"
  require_docker
  name=$1
  container=$(container_for "$name")
  port=$(port_for "$name")
  case "$(container_state "$container")" in
    running)
      if is_imported "$container"; then
        printf 'fixture: %s already running on 127.0.0.1:%s (dump already imported)\n' "$container" "$port"
        return 0
      fi
      printf 'fixture: %s running but the dump was never imported; importing now\n' "$container"
      wait_ready "$container"
      import_dump "$name" "$container"
      ;;
    stopped)
      printf 'fixture: starting existing container %s\n' "$container"
      docker start "$container" >/dev/null
      wait_ready "$container"
      if ! is_imported "$container"; then
        import_dump "$name" "$container"
      fi
      ;;
    absent)
      printf 'fixture: pulling %s\n' "$IMAGE"
      docker pull -q "$IMAGE" >/dev/null
      printf 'fixture: starting %s on 127.0.0.1:%s\n' "$container" "$port"
      if ! docker run -d --name "$container" \
        -e MARIADB_ROOT_PASSWORD="$ROOT_PASSWORD" \
        -p "127.0.0.1:$port:3306" \
        "$IMAGE" >/dev/null; then
        die "could not start $container; if the port is taken set FIXTURE_PORT_$(printf '%s' "$name" | tr '[:lower:]-' '[:upper:]_')"
      fi
      wait_ready "$container"
      import_dump "$name" "$container"
      ;;
  esac
  printf 'fixture: %s ready on 127.0.0.1:%s (schema %s, user %s)\n' "$container" "$port" "$(database_for "$name")" "$READER_USER"
}

cmd_down() {
  require_fixture "${1:-}"
  require_docker
  container=$(container_for "$1")
  if [ "$(container_state "$container")" = absent ]; then
    printf 'fixture: %s is not present\n' "$container"
    return 0
  fi
  docker rm -f -v "$container" >/dev/null
  printf 'fixture: removed %s\n' "$container"
}

cmd_status() {
  require_docker
  if pid=$(serve_pid); then
    regs=$(find "$(state_dir)/workspaces" -type f 2>/dev/null | wc -l | tr -d ' ')
    printf 'serve: running (pid %s), %s registered workspace(s), state dir %s\n' "$pid" "$regs" "$(state_dir)"
  else
    printf 'serve: not running (start it with: fixture serve)\n'
  fi
  printf '%s\t%s\t%s\t%s\t%s\n' FIXTURE CONTAINER STATE PORT IMPORTED
  for name in $(fixture_names); do
    container=$(container_for "$name")
    state=$(container_state "$container")
    imported=-
    if [ "$state" = running ]; then
      if is_imported "$container"; then imported=yes; else imported=no; fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$container" "$state" "$(port_for "$name")" "$imported"
  done
}

first_keyword() {
  # Strip leading whitespace and SQL comments, then print the first word upper-cased.
  rest=$1
  nl='
'
  while :; do
    rest=${rest#"${rest%%[![:space:]]*}"}
    case "$rest" in
      --* | '#'*)
        case "$rest" in
          *"$nl"*) rest=${rest#*"$nl"} ;;
          *) rest="" ;;
        esac
        ;;
      /\**)
        case "$rest" in
          *'*/'*) rest=${rest#*\*/} ;;
          *) rest="" ;;
        esac
        ;;
      *) break ;;
    esac
  done
  printf '%s\n' "$rest" | sed -n '1s/^\([A-Za-z_]*\).*/\1/p' | tr '[:lower:]' '[:upper:]'
}

refuse() {
  printf 'fixture: statement refused %s\n' "$*" >&2
  exit 2
}

statement_count() {
  # Count SQL statements in $1 with a scan that knows about quotes and comments:
  # a `;` inside '...', "..." or `...` or inside a comment does not separate
  # statements, and a trailing `;` followed only by blanks or comments does not
  # start a new one. Prints the count.
  printf '%s\n' "$1" | awk '
    BEGIN { q = ""; mode = "code"; seg = 0; n = 0 }
    {
      line = $0 "\n"
      len = length(line)
      i = 1
      while (i <= len) {
        c = substr(line, i, 1)
        d = substr(line, i, 2)
        if (mode == "line_comment") {
          if (c == "\n") mode = "code"
          i++; continue
        }
        if (mode == "block_comment") {
          if (d == "*/") { mode = "code"; i += 2 } else i++
          continue
        }
        if (q != "") {
          # a backslash escapes only inside single or double quotes, never in backticks
          if (c == "\\" && q != "`") { i += 2; continue }
          if (c == q) { q = "" }
          i++; continue
        }
        if (c == "\047" || c == "\"" || c == "`") { q = c; seg = 1; i++; continue }
        # `--` opens a comment only when followed by whitespace or end of input; 1--1 is arithmetic
        if (d == "--") {
          e = substr(line, i + 2, 1)
          if (e == "" || e ~ /[ \t\r\n]/) { mode = "line_comment"; i += 2; continue }
          seg = 1; i += 2; continue
        }
        if (c == "#") { mode = "line_comment"; i++; continue }
        if (d == "/*") { mode = "block_comment"; i += 2; continue }
        if (c == ";") { if (seg) n++; seg = 0; i++; continue }
        if (c !~ /[ \t\r\n]/) seg = 1
        i++
      }
    }
    END { if (seg) n++; print n }'
}

check_statement() {
  # Exit 2 unless $1 is exactly one read-only SQL statement with no client escape.
  sql=$1
  # 1. mariadb client commands: short form `\x` anywhere, long form at a line start.
  case "$sql" in
    *\\[.!?#A-Za-z]*) refuse "as a client command: backslash commands such as \\! \\. \\T \\P \\G are not allowed" ;;
  esac
  if printf '%s\n' "$sql" | grep -iqE '^[[:space:]]*(system|source|tee|use|delimiter|pager|nopager|notee|prompt|connect|status|warnings|nowarning|edit|print|rehash|charset|resetconnection|exit|quit|clear|go|ego|help)([[:space:]]|$)'; then
    refuse "as a client command: system, source, tee and other client commands are not allowed at a line start"
  fi
  # 2. executable comments are run by the server, not ignored.
  case "$sql" in
    *'/*!'* | *'/*M!'* | *'/*m!'*) refuse "as an executable comment: /*! and /*M! are not allowed" ;;
  esac
  # 3. one statement per call, counted with a quote- and comment-aware scan.
  count=$(statement_count "$sql")
  if [ "$count" -gt 1 ]; then
    refuse "as more than one statement: one statement per call (a trailing ';' is fine)"
  fi
  # 4. first keyword allow-list.
  keyword=$(first_keyword "$sql")
  case "$keyword" in
    SELECT | SHOW | DESCRIBE | DESC | EXPLAIN | WITH) ;;
    *) refuse "as a write (first keyword ${keyword:-<none>}); allowed: SELECT, SHOW, DESCRIBE, DESC, EXPLAIN, WITH" ;;
  esac
}

run_query() {
  # The one read-only path: statement check, then the SELECT-only user through the
  # sandboxed client as the unprivileged OS user. Used by `query` and by `serve`.
  require_fixture "${1:-}"
  name=$1
  sql=${2:-}
  [ -n "$sql" ] || die "usage: fixture query $name 'SELECT ...'"
  check_statement "$sql"
  require_docker
  container=$(container_for "$name")
  if [ "$(container_state "$container")" != running ]; then
    die "$container is not running; start it with: fixture up $name"
  fi
  # Unprivileged OS user, client sandbox (no \! \. tee system), no tty: the client
  # prints tab-separated rows with a header line.
  docker exec -u mysql "$container" mariadb --sandbox -u"$READER_USER" -p"$READER_PASSWORD" -D "$(database_for "$name")" --batch -e "$sql"
}

cmd_query() {
  run_query "$@"
}

serve_log() {
  printf '%s serve: %s\n' "$(date '+%H:%M:%S')" "$*"
}

owned_by_me() {
  # POSIX test has no -O; `find -prune -user` prints the path only when owned by us.
  [ -n "$(find "$1" -prune -user "$(id -un)" 2>/dev/null)" ]
}

queue_is_safe() {
  # $1 = workspace path. The agent controls the workspace, so `serve` (which runs
  # unsandboxed as the operator) must not follow anything the agent could plant:
  # .agents and .agents/queue must be real directories owned by the operator.
  for dir in "$1/.agents" "$1/.agents/queue"; do
    [ -L "$dir" ] && return 1
    [ -d "$dir" ] || return 1
    owned_by_me "$dir" || return 1
  done
  return 0
}

regular_file() {
  # true for a regular, non-symlink, single-link file owned by the operator: a hard
  # link to a host file is a regular file too, so the link count must be 1.
  [ ! -L "$1" ] && [ -f "$1" ] && [ -n "$(find "$1" -prune -links 1 -user "$(id -un)" 2>/dev/null)" ]
}

queue_write() {
  # queue_write QUEUE TARGET CONTENT: write through a fresh temp file in the queue
  # and rename it into place; mv replaces a planted link, it never follows one.
  qw_tmp=$(mktemp "$1/.serve.XXXXXX") || return 1
  printf '%s' "$3" >"$qw_tmp"
  mv -f "$qw_tmp" "$2"
}

serve_request() {
  # $1 = queue dir (resolved, see cmd_serve), $2 = request id (validated)
  queue=$1
  id=$2
  base="$queue/$id"
  req_name=""
  req_sql=""
  queue_write "$queue" "$base.working" "" || return 0
  code=1
  out=""
  if ! regular_file "$base.sql" || ! regular_file "$base.fixture"; then
    out="fixture: request refused: request files must be regular files"
  else
    req_name=$(head -n 1 "$base.fixture" 2>/dev/null || true)
    req_sql=$(cat "$base.sql" 2>/dev/null || true)
    if [ ! -f "$FIXTURES_DIR/$req_name/spec.json" ] || ! printf '%s' "$req_name" | grep -qE '^[a-z0-9-]+$'; then
      # fixed text: the name came from the workspace and must not be echoed back
      out="fixture: request refused: unknown fixture name in request"
      req_name=""
    else
      out_tmp=$(mktemp "$queue/.serve.XXXXXX")
      code=0
      (run_query "$req_name" "$req_sql") >"$out_tmp" 2>&1 || code=$?
      mv -f "$out_tmp" "$base.out"
      out=""
    fi
  fi
  [ -n "$out" ] && queue_write "$queue" "$base.out" "$out
"
  queue_write "$queue" "$base.exit" "$code
"
  serve_log "$id fixture=${req_name:-?} exit=$code"
}

cmd_serve() {
  require_docker
  state=$(state_dir)
  mkdir -p "$state/workspaces"
  if pid=$(serve_pid); then
    die "fixture serve already running (pid $pid, $state/serve.pid)"
  fi
  printf '%s\n' "$$" >"$state/serve.pid"
  # shellcheck disable=SC2064 # expand $state now; the trap must not depend on later state
  trap "rm -f '$state/serve.pid'; exit 0" INT TERM EXIT
  serve_log "watching $state/workspaces (pid $$); stop with Ctrl-C"
  while :; do
    for reg in "$state"/workspaces/*; do
      [ -f "$reg" ] || continue
      ws=$(head -n 1 "$reg" 2>/dev/null || true)
      if [ -z "$ws" ] || [ ! -d "$ws" ]; then
        rm -f "$reg"
        serve_log "dropped registration $(basename "$reg") (workspace gone)"
        continue
      fi
      queue_is_safe "$ws" || continue
      # Resolve the queue once per poll (cd -P) so a directory swapped for a link
      # after the check cannot redirect the files this iteration creates.
      queue=$(cd -P "$ws/.agents/queue" 2>/dev/null && pwd -P) || continue
      [ -L "$queue" ] && continue
      for sqlf in "$queue"/req.??????.sql; do
        [ -e "$sqlf" ] || [ -L "$sqlf" ] || continue
        id=$(basename "$sqlf" .sql)
        printf '%s' "$id" | grep -qE '^req\.[A-Za-z0-9]{6}$' || continue
        [ -e "$queue/$id.exit" ] || [ -L "$queue/$id.exit" ] && continue
        [ -e "$queue/$id.working" ] || [ -L "$queue/$id.working" ] && continue
        serve_request "$queue" "$id"
      done
    done
    sleep "$SERVE_POLL"
  done
}

command=${1:-}
[ $# -gt 0 ] && shift
case "$command" in
  generate) cmd_generate "$@" ;;
  up) cmd_up "$@" ;;
  down) cmd_down "$@" ;;
  status) cmd_status "$@" ;;
  query) cmd_query "$@" ;;
  serve) cmd_serve "$@" ;;
  -h | --help | help | "") usage; [ -n "$command" ] || exit 1 ;;
  *) die "unknown command '$command' (try: fixture --help)" ;;
esac
